services:
  prometheus:
    container_name: matuizo.va-netology-prometheus
    image: prom/prometheus:latest
    restart: unless-stopped
    ports:
      - "9090:9090"
    volumes:
      # Берем конфиг из папки 6-04, как у тебя в структуре
      - ./6-04/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml
      - prometheus_data:/prometheus
    networks:
      - matuizo.va-my-netology-hw
    depends_on:
      - pushgateway

  pushgateway:
    container_name: matuizo.va-netology-pushgateway
    image: prom/pushgateway:latest
    restart: unless-stopped
    ports:
      - "9091:9091"
    networks:
      - matuizo.va-my-netology-hw

  grafana:
  container_name: matuizo.va-netology-grafana
  image: grafana/grafana:latest
  restart: unless-stopped
  ports:
    - "80:3000"
  volumes:
    - grafana_data:/var/lib/grafana
    - ./6-04/grafana/config/custom.ini:/etc/grafana/custom.ini
  networks:
    - matuizo.va-my-netology-hw
  depends_on:
    - prometheus

volumes:
  prometheus_data:
  grafana_data:

networks:
  matuizo.va-my-netology-hw:
    driver: bridge
    ipam:
      config:
        - subnet: 10.5.0.0/16
